{
  "name": "ozeroute-e2e-automation",
  "version": "2.0.0",
  "description": "Système d'automatisation de tests End-to-End, audits de régression et remédiations logicielles pour la plateforme Ozeroute (REM4U SARL / ESPRIT)",
  "main": "runner.js",
  "scripts": {
    "test": "node runner.js --all",
    "test:all": "node runner.js --all",
    "test:nominal": "node runner.js --scenario=parcours_nominal_cdg",
    "test:deeplink": "node runner.js --scenario=parcours_acces_deeplink",
    "test:roundtrip": "node runner.js --scenario=parcours_aller_retour",
    "test:multilang": "node runner.js --scenario=parcours_multilingue_en",
    "test:anomalies": "node runner.js --scenario=audit_faille_metier_0km",
    "test:api": "node tests/api.test.js",
    "benchmark": "node benchmark.js",
    "report:open": "powershell -Command \"Start-Process .\\reports\\report.html\""
  },
  "keywords": [
    "playwright",
    "e2e",
    "testing",
    "qa",
    "ozeroute",
    "data-driven",
    "pom",
    "automation",
    "ci-cd",
    "docker",
    "regression-testing"
  ],
  "author": "Amenallah JERBI <amenallah.jerbi@esprit.tn>",
  "license": "MIT",
  "dependencies": {
    "playwright": "^1.63.0"
  }
}
